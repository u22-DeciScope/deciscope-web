# Vite開発サーバーがHTTP APIを転送する先。ブラウザには公開されない。
API_PROXY_TARGET=http://127.0.0.1:9090
# Vite開発サーバーがWebSocketを転送する先。未設定時はAPI_PROXY_TARGETから導出する。
WS_PROXY_TARGET=ws://127.0.0.1:9090

# ブラウザが利用するAPI base URL。VITE_変数のためbundleへ埋め込まれる。
VITE_API_BASE_URL=/api
# ブラウザが利用するWebSocket base URL。VITE_変数のためbundleへ埋め込まれる。
VITE_WS_BASE_URL=/ws

# Firebase Web SDKの公開設定。秘密鍵ではないが、対象projectの値を指定する。
# Firebase Web API key。
VITE_FIREBASE_API_KEY=your-web-api-key
# Firebase Authのdomain。
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Firebase project ID。
VITE_FIREBASE_PROJECT_ID=your-project-id
# Firebase Web App ID。
VITE_FIREBASE_APP_ID=your-web-app-id
# Firebase Storageを使う場合のbucket。
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
# Firebase Cloud Messagingを使う場合のsender ID。
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id

# クライアント診断ログ(会議画面の議論ツリー消失をコンソールに依存せず追跡する)。
# false にすると診断イベントのAPI送信を停止する(ブラウザ内バッファは動作する)。
VITE_DECISCOPE_CLIENT_DIAGNOSTICS=true
# 診断イベントに載せるフロントエンドのビルド識別子(commit SHA等)。
# 未設定時は開発ビルドで "dev"、本番ビルドで "unknown" になる。
VITE_FRONTEND_BUILD_VERSION=
# 以下3つは本番artifactの追跡情報。CIが設定し、本番buildでは全項目が必須。
VITE_COMMIT_SHA=
VITE_BUILD_TIMESTAMP=
# true または false。CIの正規buildは false。
VITE_DIRTY_BUILD=false
